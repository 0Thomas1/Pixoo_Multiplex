# Pixoo64 device IP address. If unset, the server will auto-discover.
PIXOO_IP=

# Optional API key for device-control commands (brightness, channel, etc.).
# If set, clients must send it via the X-API-Key header.
API_KEY="test_key"

# Set to true to run in offline simulation mode without physical hardware
# Accepts: SIMULATION=true, SIMULATED=true, or PIXOO_SIMULATED=true
# SIMULATION=false
